# 默认：由 Git 自动判定文本/二进制，仓库内统一存 LF
* text=auto eol=lf

# 源码与文档：LF
*.java   text eol=lf
*.xml    text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.properties text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.mjs    text eol=lf

# Windows 批处理与 Wrapper 脚本：CRLF
*.cmd    text eol=crlf
*.bat    text eol=crlf

# Shell 脚本（含 Maven Wrapper）：LF，否则在 Linux/macOS 上会报 bad interpreter
*.sh     text eol=lf
mvnw     text eol=lf

# 二进制：不做任何转换
*.jar    binary
*.gif    binary
*.png    binary
*.jpg    binary
*.jpeg   binary
*.ico    binary
*.woff   binary
*.woff2  binary
*.pdf    binary

# 语言统计时排除，避免 README 里的语言占比失真
mvnw.cmd linguist-vendored
mvnw     linguist-vendored
